{
  "name": "@polynote/shared",
  "version": "1.0.0",
  "description": "Shared types, utilities, and database layer for PolyNote",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "migrate": "node dist/db/migrate.js",
    "seed": "node dist/db/seed.js"
  },
  "dependencies": {
    "@types/node": "^24.6.2",
    "better-sqlite3": "^9.6.0",
    "date-fns": "^3.6.0",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
