{
  "name": "@polynote/desktop",
  "version": "1.0.0",
  "description": "PolyNote Desktop Application - Electron + React",
  "main": "dist/electron/main.js",
  "author": "PolyNote Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:all": "npm run build && electron-builder --mac --win --linux",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "package:linux": "electron-builder --linux",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "type-check": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "jest --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.61.5",
    "@tanstack/react-virtual": "^3.11.6",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.1.3",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "vis-data": "^7.1.9",
    "vis-network": "^9.1.9",
    "vite": "^7.1.9",
    "wait-on": "^9.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.0",
    "@playwright/test": "^1.55.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.0"
  },
  "build": {
    "appId": "com.polynote.desktop",
    "productName": "PolyNote",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "dist/renderer/**/*",
      "dist/electron/*.js",
      "!dist/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../packages/shared/dist",
        "to": "app/shared",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "identity": null,
      "signIgnore": [
        "node_modules"
      ],
      "type": "distribution"
    },
    "afterSign": "scripts/notarize.js",
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "category": "Office;Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "executableName": "polynote",
      "synopsis": "Universal note sync and AI-powered knowledge management",
      "description": "PolyNote enables bidirectional sync between Obsidian, Notion, Joplin, OneNote, and Apple Notes with AI-powered features."
    }
  }
}
