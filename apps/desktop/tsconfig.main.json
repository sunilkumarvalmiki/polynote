{
  "compilerOptions": {
    "outDir": "./dist/electron",
    "module": "esnext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "noEmit": false,
    "jsx": "preserve",
    "skipLibCheck": true,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@polynote/shared": ["../../packages/shared/src"],
      "@polynote/ai": ["../../packages/ai/src"],
      "@polynote/security": ["../../packages/security/src"],
      "@polynote/connectors": ["../../packages/connectors/src"]
    }
  },
  "include": ["electron/**/*.ts"],
  "exclude": ["node_modules", "dist", "src"]
}
