# PolyNote Development Container
FROM node:22-alpine

# Install development tools
RUN apk add --no-cache \
    git \
    sqlite \
    python3 \
    make \
    g++ \
    bash

# Set working directory
WORKDIR /workspace

# Copy package files
COPY package*.json ./
COPY packages/shared/package.json ./packages/shared/

# Install dependencies
RUN npm install

# Expose ports
EXPOSE 3000 3001

# Default command
CMD ["npm", "run", "dev"]